# Default assumes `docker run -p 5432:5432 postgres:16-alpine` (use 5433 if 5432 is already taken locally)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookleaf?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# AI provider: "openai" or "anthropic". Leave AI_API_KEY blank to run with AI disabled (graceful fallback).
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# Optional: point the "openai" provider at any OpenAI-compatible endpoint (e.g. Groq).
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="openai/gpt-oss-120b"
